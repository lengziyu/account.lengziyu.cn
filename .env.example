DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/account_vault?schema=public"
NEXTAUTH_SECRET="change-this-to-a-random-long-secret"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="change-this-to-a-random-long-secret"
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"

# Optional: local SQLite export source before migrating to PostgreSQL
SQLITE_SOURCE_PATH="prisma/dev.db"
SQLITE_EXPORT_PATH="prisma/sqlite-export.json"

# Optional: use push-telegram compatible env channels on Vercel
PUSH_CHANNELS="telegram,feishu"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
FEISHU_WEBHOOK_URL=""
FEISHU_SIGN_SECRET=""
